# ==========================================
# DEVELOPMENT
# ==========================================

SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=library_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

JWT_SECRET=your-development-jwt-secret
JWT_EXPIRATION=900000


# ==========================================
# PRODUCTION
# ==========================================
# For production change:
# SPRING_PROFILES_ACTIVE=prod
#
# DATABASE_URL=jdbc:postgresql://production-db:5432/library_db
# DATABASE_USERNAME=library_user
# DATABASE_PASSWORD=your_production_password
#
# REDIS_HOST=production-redis
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
#
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-production-email@gmail.com
# MAIL_PASSWORD=your-production-app-password
#
# JWT_SECRET=your-production-jwt-secret
# JWT_EXPIRATION=900000